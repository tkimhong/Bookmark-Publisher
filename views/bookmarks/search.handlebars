<h1>Search</h1>
<form action="/search" method="get">
  <input type="text" name="q" value="{{q}}" placeholder="Search bookmarks..." />
  <button type="submit">Search</button>
</form>
{{#if q}}
  <p>Results for "{{q}}":</p>
  {{#if bookmarks.length}}
    <ul>
      {{#each bookmarks}}
        <li><a href="/bookmarks/{{slug}}">{{title}}</a></li>
      {{/each}}
    </ul>
  {{else}}
    <p>No results found.</p>
  {{/if}}
{{/if}}