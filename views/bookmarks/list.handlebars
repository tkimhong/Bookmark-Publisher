<h1>All Bookmarks</h1>
{{#if bookmarks.length}}
  <ul>
    {{#each bookmarks}}
      <li>
        <a href="/bookmarks/{{slug}}">{{title}}</a>
        {{#if description}}<p>{{description}}</p>{{/if}}
        <p>
          {{#each tags}}
            <a href="/tag/{{this}}">{{this}}</a>
          {{/each}}
        </p>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>No bookmarks found.</p>
{{/if}}